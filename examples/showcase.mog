mogwai.reset

# GIZMO — Dark Theme
# Include this file at the start of your script:
#   "themes/dark.mog" include

# ── Window ────────────────────────────────────────────────────────────────────
'color.black'       -> '$theme.back'         # window background (true black)
'color.white'       -> '$theme.fore'         # window foreground
'color.black'       -> '$theme.focusFore'    # focused component foreground
'color.brightcyan'  -> '$theme.focusBack'    # focused component background

# ── Components ────────────────────────────────────────────────────────────────
'color.black'       -> '$theme.inputBack'    # input fields background
'color.white'       -> '$theme.inputFore'    # input fields foreground

# ── Buttons ───────────────────────────────────────────────────────────────────
'color.brightcyan'  -> '$theme.btnFore'      # button foreground (cyan on black)
'color.black'       -> '$theme.btnBack'      # button background
'color.black'       -> '$theme.btnFocusFore' # button focused foreground
'color.brightcyan'  -> '$theme.btnFocusBack' # button focused background

# ── Accents ───────────────────────────────────────────────────────────────────
'color.brightcyan'  -> '$theme.accent'       # accent color (highlights, titles)
'color.brightred'   -> '$theme.danger'       # error / danger color
'color.brightgreen' -> '$theme.success'      # success color
'color.brightyellow'-> '$theme.warning'      # warning color

[!
    name: 'showcase'
    title: "GIZMO — Component Showcase"
    backcolor: @$theme.back
    forecolor: @$theme.fore
    focusForecolor: @$theme.focusFore
    focusBackcolor: @$theme.focusBack

    childs:
    (
        # ── Text inputs ───────────────────────────────────────────────────────
        [!
            ui.kind: 'ui.frame'
            title: "Text inputs"
            height: 10

            childs:
            (!
                [! ui.kind: 'ui.edit'     name: 'name'     label: "Name :"     text: "Alice Dupont"]
                [! ui.kind: 'ui.password' name: 'pwd'      label: "Password :" text: "secret"]
                [! ui.kind: 'ui.integer'  name: 'age'      label: "Age :"      value: 32]
                [! ui.kind: 'ui.float'    name: 'price'    label: "Price :"    value: 99.90]
            )
        ]

        # ── Selection ─────────────────────────────────────────────────────────
        [!
            ui.kind: 'ui.frame'
            title: "Selection"
            height: 12

            childs:
            (!
                [! ui.kind: 'ui.check' name: 'active'   label: "Active"   checked: true]
                [! ui.kind: 'ui.check' name: 'archived' label: "Archived" checked: false]
                [!
                    ui.kind: 'ui.radio'
                    name: 'type'
                    label: "Type :"
                    options: ("Client" "Supplier" "Partner")
                    index: 1
                ]
                [!
                    ui.kind: 'ui.combo'
                    name: 'category'
                    label: "Category :"
                    options: ("All" "Clients" "Suppliers" "Partners")
                    index: 2
                ]
            )
        ]

        # ── Data ──────────────────────────────────────────────────────────────
        [!
            ui.kind: 'ui.frame'
            title: "Data"
            height: 16

            childs:
            (!
                [!
                    ui.kind: 'ui.tableview'
                    name: 'contacts'
                    height: 10
                    columns: ("Name" "Type" "City")
                    rows:
                    (
                        ("Dupont Marcel"  "Client"    "Lyon")
                        ("Martin Sophie"  "Supplier"  "Paris")
                        ("Bernard Eric"   "Partner"   "Grenoble")
                        ("Leroy Anne"     "Client"    "Marseille")
                    )
                ]
                
                [! ui.kind: 'ui.progress' name: 'progress' value: 65 min: 0 max: 100]
            )
        ]

        # ── Buttons ───────────────────────────────────────────────────────────
        [!
            ui.kind: 'ui.button'
            label: "New"
            forecolor: @$theme.btnFore
            backcolor: @$theme.btnBack
            focusForecolor: @$theme.btnFocusFore
            focusBackcolor: @$theme.btnFocusBack
        ]

        [!
            ui.kind: 'ui.button'
            label: "Edit"
            forecolor: @$theme.btnFore
            backcolor: @$theme.btnBack
            focusForecolor: @$theme.btnFocusFore
            focusBackcolor: @$theme.btnFocusBack
        ]

        [!
            ui.kind: 'ui.button'
            label: "Close"
            forecolor: @$theme.btnFore
            backcolor: @$theme.btnBack
            focusForecolor: @$theme.btnFocusFore
            focusBackcolor: @$theme.btnFocusBack
            onClick: { false window.hide }
        ]
    )
]

window.show drop
